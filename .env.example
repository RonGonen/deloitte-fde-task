# Copy to .env for NON-SECRET settings only (.env is git-ignored). All values are optional.
#
# Secrets are never read from a file. Provide them in the shell for the session you run the app in:
#   export ANTHROPIC_API_KEY=...   # only if you use the Anthropic API provider
#   export APP_TOKEN=...           # required for any non-loopback client; sent as "Authorization: Bearer <token>"

# LLM provider: auto | claude_cli | anthropic | rules
#   auto     -> anthropic if ANTHROPIC_API_KEY is in the environment, else claude_cli if the `claude` CLI is installed, else rules
#   claude_cli -> headless Claude Code CLI using the account you are logged into (no API key needed)
#   anthropic  -> Anthropic API via the official SDK (needs ANTHROPIC_API_KEY in the environment)
#   rules      -> deterministic rules-based router only, no LLM
LLM_PROVIDER=auto
LLM_MODEL=claude-fable-5-1

# Server
HOST=127.0.0.1
PORT=8000

# Data
# OFFLINE=1 uses committed snapshots only (no network fetches)
OFFLINE=0
CACHE_DIR=.cache
