# Copy to .env (never commit .env). All values are optional.

# LLM provider: auto | claude_cli | anthropic | rules
#   auto     -> anthropic if ANTHROPIC_API_KEY is set, else claude_cli if the `claude` CLI is installed, else rules
#   claude_cli -> headless Claude Code CLI using the account you are logged into (no API key needed)
#   anthropic  -> Anthropic API via the official SDK (needs ANTHROPIC_API_KEY)
#   rules      -> deterministic rules-based router only, no LLM
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
LLM_MODEL=claude-fable-5-1

# Server
HOST=127.0.0.1
PORT=8000

# Data
# OFFLINE=1 uses committed snapshots only (no network fetches)
OFFLINE=0
CACHE_DIR=.cache
